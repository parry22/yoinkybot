# --- Core ---
DATABASE_URL=postgres://localhost:5432/yoink
PORT=3001
PUBLIC_URL=http://localhost:3001
CHECKOUT_RETURN_URL=https://app.meetyoinky.com/app/settings   # where Dodo returns users after checkout (web-first: land back in the app; a t.me link also works for bot-only checkout)
# The web app's own origin — allowlisted return target for the OAuth connect
# flow (Settings' "Connect X" button uses this so its callback bounces back to
# the web app instead of showing the Telegram-flavored static page).
WEB_APP_URL=http://localhost:3002

# --- Telegram (Phase 1) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_ID=          # your Telegram user id — job failures/crashes DM you (throttled)

# --- Speech to text (Phase 1) --- tried in order: Sarvam, Groq, OpenAI Whisper
SARVAM_API_KEY=
GROQ_API_KEY=              # console.groq.com — fast/cheap hosted Whisper
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=            # Whisper fallback + embeddings

# --- LLM (single model: Grok 4.5) ---
# Every chat/completion call goes through one gateway. LLM_TRANSPORT picks how it
# reaches Grok 4.5: 'openrouter' (default; cross-provider retry) or 'xai' (direct
# api.x.ai — unlocks the x-grok-conv-id cache-affinity header, cached_tokens in
# usage, and reasoning_effort). Flip to 'xai' ONLY after XAI_API_KEY is set; it's
# a one-env-var rollback. tier→reasoning_effort now (cheap/none→low, frontier→high).
LLM_TRANSPORT=openrouter                              # openrouter | xai
OPENROUTER_API_KEY=
OPENROUTER_PROVIDER_IGNORE=Baidu,Alibaba,StreamLake   # US/EU hosts only; edit to taste
#MODEL_CHAT=x-ai/grok-4.5                              # OpenRouter model id. PROD = x-ai/grok-4.5 (set on Vercel + Railway).
                                                       #   For LOCAL dev, override in packages/backend/.env with a cheap
                                                       #   same-family model (x-ai/grok-4.1-fast) so development doesn't
                                                       #   bill frontier prices. Keep the vendor the same — a cheap model
                                                       #   from another family changes the JSON behaviour these prompts rely on.
XAI_API_KEY=                                          # required only when LLM_TRANSPORT=xai
#XAI_BASE_URL=https://api.x.ai/v1
#XAI_MODEL=grok-4.5                                   # VERIFY the exact id in the xAI console
#LLM_DEBUG=1                                           # logs the raw usage payload (cached_tokens shape) per call

# --- Agent SDK runtime (docs/INTERNAL §3n; RAILWAY-ONLY, never Vercel) ---
# The bounded agent loops (+ chat brain) can run on the Claude Agent SDK instead
# of the bespoke tool-loop runner, routed via a LiteLLM proxy → OpenRouter →
# grok-4.5. Local default stays 'legacy' (there is no LiteLLM proxy on a laptop),
# but ALL SIX ARE 'sdk' IN PRODUCTION as of 2026-07-25 — set on the Railway
# backend, not here. Validate any change with scripts/validate-agent-runtime.ts.
AGENT_RUNTIME_VIRAL=legacy                             # legacy | sdk
AGENT_RUNTIME_TREND_TAKE=legacy
AGENT_RUNTIME_CONSISTENCY=legacy
AGENT_RUNTIME_BUYER=legacy
AGENT_RUNTIME_REPLY=legacy
AGENT_RUNTIME_CHAT=legacy
LITELLM_BASE_URL=                                      # e.g. http://litellm.railway.internal:4000 (private)
LITELLM_API_KEY=                                       # a VIRTUAL key scoped to the agent models, NOT the master key
#AGENT_MODEL=yoinky-agent                              # LiteLLM model_name the SDK sends
#AGENT_FALLBACK_MODEL=yoinky-agent-fallback
#AGENT_MAX_CONCURRENCY=2                               # concurrent SDK subprocesses — enforced by agent-runtime/capacity.ts
#AGENT_MAX_BUDGET_USD=0.5                              # per-loop hard cost ceiling → maxBudgetUsd
# Admission control. The Railway plan is NOT the binding constraint (measured:
# 8 GB / 8 vCPU limit against a ~156 MB idle backend) — the bound is. A loop that
# cannot get a slot within the timeout runs on the legacy runner instead.
#AGENT_SUBPROCESS_MB=1024                              # estimated footprint of ONE subprocess
#AGENT_MEMORY_RESERVE_MB=512                           # kept free for Fastify / pg-boss / the bot
#AGENT_ACQUIRE_TIMEOUT_MS=20000                        # wait for a slot before falling back
#AGENT_SDK_FALLBACK_TO_LEGACY=true                     # re-run on legacy when an SDK run fails (logs 'agent-runtime FALLBACK')
# LiteLLM service env (set on the LiteLLM Railway service, NOT the backend):
#   LITELLM_MASTER_KEY=...    (admin key; mint the virtual key above from it)
#   OPENROUTER_API_KEY=...    (upstream; same key the backend already uses)
#   DATABASE_URL=...          (REQUIRED — virtual keys are DB-backed; there is no
#                              static virtual-key block in config.yaml. Point it
#                              at a SEPARATE Neon project, never yoinkybot-prod,
#                              and use the DIRECT endpoint: prisma migrations
#                              cannot run through Neon's transaction-mode pooler.)
#   PORT=4000
#   RAILWAY_DOCKERFILE_PATH=Dockerfile.litellm

# --- Embeddings (separate from the chat model — GLM 5.2 is chat-only) ---
# OpenAI when OPENAI_API_KEY (above) is set, else Qwen/DashScope.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=1536
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v4

# --- Trends (X + LinkedIn via Apify by default; news search as fallback) ---
# Actor ids below are verified against live Apify runs (2026-07-04) — see
# trends/providers/apify.ts and capture/imports/apify-profile.ts for field shapes.
TREND_PROVIDER=apify        # apify | brave | tavily | x_api (falls through in order)
APIFY_TOKEN=                # apify.com account token — powers the X/LinkedIn actors
APIFY_X_ACTOR=kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-post-search
# Profile-history actors for the strategist's /connect (ingest a user's own posts)
APIFY_X_PROFILE_ACTOR=kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
APIFY_LINKEDIN_PROFILE_ACTOR=apimaestro/linkedin-profile-posts
BRAVE_API_KEY=              # brave.com/search/api — 2,000 free queries/mo
TAVILY_API_KEY=
X_API_BEARER_TOKEN=         # optional: official X API v2

# X profile ingestion: twitterapi.io (twitterapi.io) — preferred over Apify when
# set. Richer than the Apify actor: engagement counts (likes/replies/retweets/
# views), thread/reply context, bio + follower count. Falls back to Apify when
# unset. LinkedIn always uses Apify — twitterapi.io is X-only.
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io

# --- Bounded agent loops (all hard caps; defaults are fine — see llm/tool-loop.ts) ---
#MAX_TOOL_CALLS_PER_TURN=3            # chat brain: tools per conversational turn (converse.v3)
#CONSISTENCY_AMBIGUITY_DELTA=0.08     # top-2 position-match distance gap below which the agent path runs
#CONSISTENCY_CONFIDENCE_THRESHOLD=0.6 # agent catches below this confidence are reported as clear
#CONSISTENCY_MAX_TOOL_CALLS=3
#REPLY_AGENT_MAX_TOOL_CALLS=3         # reply drafting agent (reply-draft.v2)
#TREND_TAKE_MAX_TOOL_CALLS=4          # macro-moment composition agent (trend-take.v2)
#MIN_DAILY_TREND_SENDS=2              # per-RUN send cap (trendMatch runs 3×/day) — one run serves a helping, not the whole day
#MAX_DAILY_TREND_SENDS=3             # hard per-DAY ceiling/user, checked before any provider spend (replaced the old 4-per-month cap)
#BUZZ_THRESHOLD=0.5                   # verified trend volume (trends/scoring.ts) must clear this
#NICHE_THRESHOLD=0.6                  # max cosine distance trend↔nearest position (niche gate; on-niche ≈0.40-0.55 live, junk ≥0.61)
#TWITTERAPI_SEARCH_PAGE_CAP=3         # advanced_search pages per query — never paginate unbounded
# Daily viral tweet case study (§3h) — a niche-relevant high-impression tweet + why-it-worked breakdown.
#VIRAL_VIEW_MIN=100000                # impression band floor (defining gate)
#VIRAL_VIEW_MAX=9999999               # impression band ceiling (skip once-a-year megaviral outliers)
#VIRAL_MIN_FAVES_PROXY=600            # search floor by likes (no min_views operator exists), then filter by real viewCount
#VIRAL_RECENCY_HOURS=48               # "blew up recently" window, not an evergreen-viral archive lookup
#VIRAL_AUTHOR_COOLDOWN_DAYS=14        # don't resurface the same author within this window
#VIRAL_MAX_TOOL_CALLS=3               # bounded composition agent (why-it-worked + one angle)

# --- Buyer Radar (§3h) — in-market prospect discovery, approval-only replies ---
# Uses TWITTERAPI_IO_KEY; unset → feature unavailable (fail-closed, says so). Never auto-sends.
#BUYER_RADAR_ENABLED=true             # master switch for the whole feature
#BUYER_RADAR_PROACTIVE=false          # recurring scan/DM path — DARK by default; pull-only launch
#INTENT_THRESHOLD=0.45                # deterministic intent gate (buyer/scoring.ts, 0..1)
#BUYER_NICHE_THRESHOLD=0.55           # max cosine distance candidate↔ICP vector (tighter than trends)
#BUYER_LOOKBACK_HOURS=168             # intent decays; short recency window (72h left niche categories with no volume)
#BUYER_WIDEN_FACTOR=4                 # when a pass finds nothing, retry the strongest queries over this × the window
#MAX_BUYER_TOOL_CALLS=4               # bounded composition loop cap
#BUYER_SEARCH_PAGE_CAP=2              # advanced_search pages per query (search is per-user, paid)
#BUYER_MAX_QUERIES=8                  # distilled intent queries per scan
# (no BUYER_MONTHLY_SIGNAL_CAP — the cap is per-plan in billing/entitlements.ts,
#  Growth 25 / Scale unlimited. The old env var was read by nothing.)
#BUYER_AUTHOR_COOLDOWN_DAYS=21        # don't resurface the same prospect within this window

# --- Automations (multi-automation "auto agent", §3l) ---
# Approval-mode automations work out of the box; the unattended AUTO cron ships DARK.
#AUTOMATIONS_AUTO_ENABLED=false        # master switch for unattended auto-mode posting
#AUTOMATION_USER_DAILY_CAP=3           # global posts/day across ALL of a user's automations
#AUTOMATION_AUTO_DELAY_MIN=60          # auto mode schedules N minutes out (cancellable before it fires)
#AUTOMATION_AUTO_WARMUP=3              # first N posts of a new auto automation route via approval
#AUTOMATION_MAX_EDITS=5                # edit-loop cap before forcing approve/reject
#AUTOMATION_DEFAULT_MONTHLY_CAP=30     # default monthly post cap for a new automation

# --- User-context OAuth apps (onboarding connect §3f + scheduled posting §3e) ---
# One consent covers both: verified identity for the onboarding read AND the
# write token for publishing. Without these, onboarding falls back to the
# typed-handle ask, and a due scheduled post fails closed with "not connected
# for posting". Redirect URIs are ${PUBLIC_URL}/oauth/<platform>/callback —
# register them in each platform app, and PUBLIC_URL must be public HTTPS
# (Telegram rejects localhost URL buttons; use a tunnel for local testing).
#   X: developer.x.com → Project + App → User authentication settings →
#      OAuth 2.0, type "Web App". Scopes used: tweet.read tweet.write
#      users.read offline.access. Free tier covers the connect (1 users/me
#      read each) + low-volume posting; higher volume needs a paid tier.
#   LinkedIn: developer.linkedin.com → create app (needs a Company Page) →
#      add products "Sign In with LinkedIn using OpenID Connect" and
#      "Share on LinkedIn" (both self-serve) → Auth tab → redirect URL.
#      Scopes used: w_member_social openid profile. No open scope reads
#      member posts — the profile-URL scrape stays the read path.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Web app (packages/web) ---
# The web app runs backend domain code in-process, so it reads THIS same env
# (packages/web/.env.local is symlinked to packages/backend/.env). It needs at
# least DATABASE_URL + OPENROUTER_API_KEY to be functional.
#
# Auth is CLERK. Sign-in/up, sessions, and social logins (Google, X) are all
# managed in the Clerk dashboard for app_3GuEglSCyTcG11r4RQTo89Ve9O3. The app
# maps a Clerk user to our users row by clerk_user_id and starts the 7-day trial
# on first sign-in. REQUIRED for the web app to boot (grab both from Clerk →
# API keys). NEXT_PUBLIC_* is client-safe; the secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # pk_test_… / pk_live_…
CLERK_SECRET_KEY=                    # sk_test_… / sk_live_…  (server-only, never expose)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# X posting-connect (separate from Clerk sign-in): the in-app "Connect X" flow
# uses X_CLIENT_ID / X_CLIENT_SECRET above to get tweet.write + read the history.

# --- Product analytics (PostHog, server-side) ---
# Optional. Unset = every analytics call is a silent no-op. This is a Telegram
# backend with no web frontend, so there's NO browser snippet — events are
# captured server-side at product choke points (analytics/posthog.ts), keyed by
# the internal user id. Use the PROJECT API key (starts with phc_), not a
# personal key. Host is us or eu ingestion depending on your project region.
POSTHOG_API_KEY=          # phc_… project key from PostHog → Settings → Project
POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com
POSTHOG_PERSONAL_API_KEY= # optional: personal API key (phx_…) so account wipe erases the user's PostHog person too
POSTHOG_PROJECT_ID=       # optional: numeric project id, required alongside the personal key for wipe erasure

# --- Billing: DodoPayments (Phase 6) ---
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENV=test_mode         # test_mode | live_mode
DODO_PRODUCT_PAID=         # Dodo product id for the paid "Growth" tier
DODO_PRODUCT_SCALE=pdt_0NjfwWTz5IVGf2I07R6Vd   # Dodo product id for the "Scale" tier (Settings → move to Scale)
DODO_PRODUCT_FOUNDING=     # Dodo product id for the founding cohort tier (unset = Founding button hidden)
# Price copy. Nothing reads these from Dodo — a price change is a THREE-place edit:
# the Dodo dashboard, these vars, and the landing repo (yoinky-landing/app/
# (frontend)/components/HomePricing.tsx). Today: early-bird $9 / $49, anchored
# against the standard $29 / $79.
PAID_PRICE_LABEL=$9/mo     # Growth — /upgrade copy + checkout button + Settings plan picker
PAID_PRICE_WAS_LABEL=$29   # display-only strikethrough beside the Growth price
SCALE_PRICE_LABEL=$49/mo   # Scale — Settings plan picker
SCALE_PRICE_WAS_LABEL=$79  # display-only strikethrough beside the Scale price
PAYWALL_ENABLED=false      # false = everyone gets full features (testing); true = enforce plans (boot warns if false in prod). MUST be true for the 7-day trial to actually gate (web + Telegram) once it lapses.
PAYWALL_WHITELIST=         # comma-separated Telegram ids that bypass the paywall (testers); ADMIN_TELEGRAM_ID is always exempt on top of this
FREE_DRAFT_ALLOWANCE=3     # NOTE: superseded by the post-diagnosis hard wall — free users are blocked from drafting entirely until they upgrade
TRIAL_DAYS=7               # length of the free trial every new signup gets (full paid-tier access, then the upgrade wall)
