# --- Core ---
DATABASE_URL=postgres://localhost:5432/yoink
PORT=3001
PUBLIC_URL=http://localhost:3001
CHECKOUT_RETURN_URL=https://t.me/your_bot   # where Dodo returns users after checkout

# --- Telegram (Phase 1) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_ID=          # your Telegram user id — job failures/crashes DM you (throttled)

# --- Speech to text (Phase 1) --- tried in order: Sarvam, Groq, OpenAI Whisper
SARVAM_API_KEY=
GROQ_API_KEY=              # console.groq.com — fast/cheap hosted Whisper
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=            # Whisper fallback + embeddings

# --- LLMs ---
ANTHROPIC_API_KEY=         # frontier tier (synthesis, consistency, composition)
KIMI_API_KEY=              # cheap tier (extraction, classification)
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMS=1536

# Qwen (DashScope, OpenAI-compatible mode) — fallback provider covering whichever
# of the above (frontier / cheap / embeddings) doesn't have a dedicated key set.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_CHEAP=qwen-turbo
QWEN_MODEL_FRONTIER=qwen-max
QWEN_EMBEDDING_MODEL=text-embedding-v4

# --- Trends (X + LinkedIn via Apify by default; news search as fallback) ---
# Actor ids below are verified against live Apify runs (2026-07-04) — see
# trends/providers/apify.ts and capture/imports/apify-profile.ts for field shapes.
TREND_PROVIDER=apify        # apify | brave | tavily | x_api (falls through in order)
APIFY_TOKEN=                # apify.com account token — powers the X/LinkedIn actors
APIFY_X_ACTOR=kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-post-search
# Profile-history actors for the strategist's /connect (ingest a user's own posts)
APIFY_X_PROFILE_ACTOR=kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
APIFY_LINKEDIN_PROFILE_ACTOR=apimaestro/linkedin-profile-posts
BRAVE_API_KEY=              # brave.com/search/api — 2,000 free queries/mo
TAVILY_API_KEY=
X_API_BEARER_TOKEN=         # optional: official X API v2

# X profile ingestion: twitterapi.io (twitterapi.io) — preferred over Apify when
# set. Richer than the Apify actor: engagement counts (likes/replies/retweets/
# views), thread/reply context, bio + follower count. Falls back to Apify when
# unset. LinkedIn always uses Apify — twitterapi.io is X-only.
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io

# --- Billing: DodoPayments (Phase 6) ---
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENV=test_mode         # test_mode | live_mode
DODO_PRODUCT_PAID=         # Dodo product id for the paid tier
DODO_PRODUCT_FOUNDING=     # Dodo product id for the founding cohort tier
PAYWALL_ENABLED=false      # false = everyone gets full features (testing); true = enforce plans
