{
  "name": "yoink",
  "private": true,
  "version": "0.1.0",
  "description": "Yoinky, the open source Company Narrative Engine for structured knowledge, governed narratives, and traceable content.",
  "scripts": {
    "dev": "pnpm --filter @yoink/backend dev",
    "dev:web": "pnpm --filter @yoink/web dev",
    "dev:all": "pnpm --parallel --filter @yoink/backend --filter @yoink/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm -r typecheck && pnpm --filter @yoink/web lint && pnpm -r test",
    "db:migrate": "pnpm --filter @yoink/backend db:migrate"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss": ">=8.5.18",
      "fast-uri": ">=4.1.2",
      "ip-address": ">=10.3.1",
      "hono": ">=4.12.34",
      "@hono/node-server": ">=2.0.5",
      "find-my-way": ">=9.7.0",
      "sharp": ">=0.35.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
