{
  "name": "@yoink/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./web": {
      "types": "./src/web.ts",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc && mkdir -p dist/db/migrations && cp -R src/db/migrations/. dist/db/migrations/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:diagnosis": "tsx --env-file=.env src/evals/diagnosis-eval.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.218",
    "fastify": "^5.12.5",
    "grammy": "^1.34.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "posthog-node": "^5.41.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
